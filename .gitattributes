# Notebook output stripping rules
# More specific patterns override earlier patterns

# STRIP outputs from all notebooks by default
*.ipynb filter=nbwipers diff=nbwipers

# KEEP outputs in documentation notebooks (docs/)
# This overrides the above pattern for docs/**/*.ipynb
docs/**/*.ipynb !filter

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.md text
*.py text
*.pyx text
*.c text
*.sh text
*.css text
*.js text
*.json text
*.txt text
*.yaml text
*.yml text
*.toml text
*.config text

# Declare files that will always have CRLF line endings on checkout.
#*.sln text eol=crlf

# Normalize line endings to LF - in the index AND on checkout.
# `text` is boolean: only `auto` is special. Bare `text=lf` leaves eol
# unspecified, so the host's core.autocrlf decides the working tree and files
# are not converted on checkout. Verified 2026-08-07 with
# `git check-attr text eol -- README.md` across the estate.
* text=auto eol=lf
